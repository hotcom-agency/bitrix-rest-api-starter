.PHONY: up up-dev down down-dev migration-create migration-up migration-down migration-status generate-types composer-install shell backup-create backup-restore setup-init setup-docker setup-local setup-finish db-reset

up:
	docker compose up -d --build --force-recreate

down:
	docker compose -f docker-compose.yml down

up-dev:
	docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build --force-recreate

down-dev:
	docker compose -f docker-compose.yml -f docker-compose.dev.yml down

migration-create:
	$(if $(and $(N),$(D)),,$(error Ошибка: укажите параметры N=ИмяМиграции и D="Описание"))
	docker compose exec -T php php local/modules/sprint.migration/tools/migrate.php create --from=MigrationBuilder --name=$(N) --desc="$(D)"

migration-up:
	docker compose exec php php local/modules/sprint.migration/tools/migrate.php up

migration-down:
	docker compose exec php php local/modules/sprint.migration/tools/migrate.php down

migration-status:
	docker compose exec php php local/modules/sprint.migration/tools/migrate.php list

generate-types:
	docker compose exec php /bin/sh -c "php bitrix/bitrix.php orm:annotate -m all"

composer-install:
	docker compose exec php /bin/sh -c "composer install"

shell:
	docker compose exec php bash

backup-create:
	mkdir -p backups
	docker compose exec -T -e DB_HOST -e DB_USER -e DB_PASSWORD -e DB_NAME php sh -c 'cd /var/www/html && mariadb-dump --ssl=0 -h $$DB_HOST -u $$DB_USER -p$$DB_PASSWORD $$DB_NAME > dump.sql && tar --exclude="upload/tmp" -czf /var/www/html/backups/backup_$$(date +%Y-%m-%d_%H%M%S).tar.gz upload dump.sql && rm -f dump.sql && find /var/www/html/backups -name "*.tar.gz" -mtime +10 -type f -delete'

backup-restore:
	@if [ -z "$(FILE)" ]; then echo "Ошибка: Укажите файл бэкапа. Пример: make backup-restore FILE=имя_файла.tar.gz"; exit 1; fi
	docker compose exec -T -e DB_HOST -e DB_USER -e DB_PASSWORD -e DB_NAME php sh -c 'cd /var/www/html && tar -xzf /var/www/html/backups/$(FILE) && mariadb -h $$DB_HOST -u $$DB_USER -p$$DB_PASSWORD $$DB_NAME < dump.sql && rm -f dump.sql'

setup-init:
	@bash scripts/init.sh

setup-docker:
	@chmod +x scripts/*.sh
	@bash scripts/setup-docker.sh

setup-local:
	@chmod +x scripts/*.sh
	@bash scripts/setup-local.sh

setup-finish:
	@chmod +x scripts/*.sh
	@bash scripts/post-install.sh

db-reset:
	@if [ "$(CONFIRM)" != "yes" ]; then echo "Ошибка: команда удаляет базу данных. Пример: make db-reset CONFIRM=yes"; exit 1; fi
	docker compose exec -T database sh -c 'mariadb -u root -p"$$MARIADB_ROOT_PASSWORD" -e "DROP DATABASE IF EXISTS \`$$MARIADB_DATABASE\`; CREATE DATABASE \`$$MARIADB_DATABASE\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"'
	docker compose restart php
